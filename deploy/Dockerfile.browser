FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src:/app/vendor/browser-use-camoufox \
    BROWSER_BACKEND=camoufox \
    BROWSER_HEADLESS=false \
    EGRESS_READY=false \
    MOZ_WEBRENDER=0 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GALLIUM_DRIVER=llvmpipe

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git xvfb xauth fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# This is a diagnostic headed browser using Xvfb and software rendering; it makes no GPU claim.
RUN pip install --no-cache-dir \
      "fastapi==0.129.2" \
      "uvicorn[standard]==0.41.0" \
      "pydantic==2.13.4" \
      "httpx==0.28.1" \
      "camoufox==0.4.11" \
      "playwright==1.51.0" \
    && python -m playwright install-deps firefox \
    && python -m camoufox fetch

COPY worker ./worker
COPY src ./src
COPY config/artifacts.lock.json ./config/artifacts.lock.json
COPY vendor/browser-use-camoufox/browser_use/browser/adapter.py ./vendor/browser-use-camoufox/browser_use/browser/adapter.py
COPY vendor/browser-use-camoufox/LICENSE ./vendor/browser-use-camoufox/LICENSE

# The profile directory is a separate volume from the worker's SQLite state volume.
RUN mkdir -p /app/runtime/worker-state/profiles/default

EXPOSE 7070
CMD ["xvfb-run", "-a", "-s", "-screen 0 1440x1000x24", "python", "-m", "worker.app", "--host", "0.0.0.0", "--port", "7070"]
