ARG BASE_CONTROL_IMAGE=browser-mcp-local-control:pre-compact-generic-20261030
FROM ${BASE_CONTROL_IMAGE}

# Overlay the reviewed application source and UI onto the existing control image.
# This avoids reinstalling dependencies and leaves the browser image untouched.
COPY src/browser_mcp /app/src/browser_mcp
COPY src/browser_mcp /usr/local/lib/python3.12/site-packages/browser_mcp
COPY ui /app/ui
