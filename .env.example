# Windows-native llama.cpp OpenAI-compatible endpoint, exposed to Docker Desktop.
MODEL_BASE_URL=http://host.docker.internal:8081/v1
MODEL_ALIAS=fara-browser

# Model API key auth is off by default. For an existing key file, bootstrap it
# explicitly and start with deploy/compose.model-auth.yaml as a Compose overlay.
# python scripts/bootstrap_secrets.py --model-key-file <existing-key-file>
# docker compose -f deploy/compose.yaml -f deploy/compose.model-auth.yaml up --build

# Public URL used for local browser redirects and same-origin cookies.
BROWSER_MCP_ORIGIN=http://localhost:8080

# Per-container ceilings. Browser memory includes its renderer processes.
# The Windows llama-server has separate host/GPU memory and is not included.
BROWSER_MEMORY_LIMIT=2g
BROWSER_CPU_LIMIT=4.0
CONTROL_MEMORY_LIMIT=768m
CONTROL_CPU_LIMIT=2.0
